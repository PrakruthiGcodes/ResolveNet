# Dependencies (reinstalled via package.json, never committed)
node_modules/

# Environment variables - real secrets/local config live only on each
# machine or in the deployment platform's settings, never in the repo.
# Matches backend/.env, frontend/.env, etc. at any depth.
.env
.env.*.local
*.local

# Logs
*.log
npm-debug.log*

# Frontend build output (regenerated by `npm run build`)
dist/
dist-ssr/

# Citizen-uploaded complaint images - not durable/portable across
# environments (see Step 6 deployment audit), and not source code.
backend/uploads/*
!backend/uploads/.gitkeep

# Python (ai-engine)
.venv/
venv/
__pycache__/
*.pyc

# AI training data/artifacts - large, regenerable. The dataset and training
# runs are not needed to run the app. The app needs the Teachable Machine model
# in ai-engine/model/teachable_machine/, which is tracked (see ai-engine/.gitignore).
ai-engine/dataset/
ai-engine/runs/
*.cache

# Private keys and certificates
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code session-local tooling state - not part of the project
.claude/
